---
{/* TODO: Replace YOUR_FORM_ID with your Formspree form ID from https://formspree.io */}
const formAction = "https://formspree.io/f/YOUR_FORM_ID";

const inputClass =
  "peer w-full bg-transparent border-0 border-b border-warm-200 px-0 py-2.5 font-body text-[15px] text-warm-800 placeholder-transparent focus:outline-none focus:border-warm-500 transition-colors duration-300";

// Floating label: sits like a placeholder when empty, rises when focused/filled.
const labelClass =
  "absolute left-0 -top-3 text-[0.68rem] tracking-[0.18em] uppercase text-warm-500 transition-all duration-200 pointer-events-none " +
  "peer-placeholder-shown:top-2.5 peer-placeholder-shown:text-[15px] peer-placeholder-shown:tracking-normal peer-placeholder-shown:normal-case peer-placeholder-shown:text-warm-400 " +
  "peer-focus:-top-3 peer-focus:text-[0.68rem] peer-focus:tracking-[0.18em] peer-focus:uppercase peer-focus:text-warm-600";
---

<form action={formAction} method="POST" class="space-y-9">
  <div class="grid md:grid-cols-2 gap-9">
    <div class="relative">
      <input type="text" id="first-name" name="first-name" required placeholder=" " class={inputClass} />
      <label for="first-name" class={labelClass}>First Name *</label>
    </div>
    <div class="relative">
      <input type="text" id="last-name" name="last-name" required placeholder=" " class={inputClass} />
      <label for="last-name" class={labelClass}>Last Name *</label>
    </div>
  </div>

  <div class="relative">
    <input type="email" id="email" name="email" required placeholder=" " class={inputClass} />
    <label for="email" class={labelClass}>Email Address *</label>
  </div>

  <div class="relative">
    <input type="tel" id="phone" name="phone" placeholder=" " class={inputClass} />
    <label for="phone" class={labelClass}>Phone</label>
  </div>

  <div class="relative">
    <textarea id="message" name="message" rows="4" placeholder=" " class={`${inputClass} resize-none`}></textarea>
    <label for="message" class={labelClass}>Message</label>
  </div>

  <button
    type="submit"
    class="group w-full flex items-center justify-center gap-3 px-10 py-4 bg-warm-800 text-white font-body text-xs tracking-[0.25em] uppercase rounded-full hover:bg-warm-900 transition-all duration-300"
  >
    Send Message
    <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
  </button>
</form>
