---
{/* TODO: Replace YOUR_FORM_ID with your Formspree form ID from https://formspree.io */}
const formAction = "https://formspree.io/f/YOUR_FORM_ID";

const fieldClass =
  "w-full px-4 py-3 bg-warm-50/60 border border-warm-200 rounded-xl font-body text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-warm-300 focus:ring-4 focus:ring-warm-200/50 focus:bg-white transition duration-300";
const labelClass = "block font-body text-xs tracking-widest uppercase text-warm-500 mb-2";
---

<form action={formAction} method="POST" class="space-y-6">
  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <label for="first-name" class={labelClass}>First Name *</label>
      <input type="text" id="first-name" name="first-name" required class={fieldClass} />
    </div>
    <div>
      <label for="last-name" class={labelClass}>Last Name *</label>
      <input type="text" id="last-name" name="last-name" required class={fieldClass} />
    </div>
  </div>
  <div>
    <label for="email" class={labelClass}>Email Address *</label>
    <input type="email" id="email" name="email" required class={fieldClass} />
  </div>
  <div>
    <label for="phone" class={labelClass}>Phone</label>
    <input type="tel" id="phone" name="phone" class={fieldClass} />
  </div>
  <div>
    <label for="message" class={labelClass}>Message</label>
    <textarea id="message" name="message" rows="5" class={`${fieldClass} resize-y`}></textarea>
  </div>
  <div class="text-center pt-2">
    <button
      type="submit"
      class="px-10 py-3.5 bg-warm-700 text-white font-body text-xs tracking-[0.2em] uppercase rounded-full hover:bg-warm-800 transition-colors duration-300 shadow-sm"
    >
      Send Message
    </button>
  </div>
</form>
