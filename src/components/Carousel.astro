---
import fs from 'node:fs';
import path from 'node:path';

// Auto-load every image dropped into public/images/carousel/
const dir = path.join(process.cwd(), 'public', 'images', 'carousel');
let files: string[] = [];
try {
  files = fs
    .readdirSync(dir)
    .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
} catch {
  files = [];
}
const images = files.map((f) => `/images/carousel/${encodeURIComponent(f)}`);
---

{images.length > 0 && (
  <section class="w-full bg-warm-50 py-16 md:py-24">
    <div class="relative max-w-6xl mx-auto px-6 md:px-14">
      {images.length > 1 && (
        <>
          <button
            class="strip-prev absolute left-1 md:left-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-11 h-11 rounded-full bg-white text-warm-700 text-2xl shadow-md hover:bg-warm-100 transition"
            aria-label="Previous photos"
          >
            <span class="-mt-0.5">&lsaquo;</span>
          </button>
          <button
            class="strip-next absolute right-1 md:right-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-11 h-11 rounded-full bg-white text-warm-700 text-2xl shadow-md hover:bg-warm-100 transition"
            aria-label="Next photos"
          >
            <span class="-mt-0.5">&rsaquo;</span>
          </button>
        </>
      )}

      <div class="strip flex gap-4 md:gap-5 overflow-x-auto scroll-smooth snap-x no-scrollbar py-2">
        {images.map((src, i) => (
          <button
            class="strip-item snap-start shrink-0 w-44 md:w-56 aspect-[3/4] rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 group"
            data-index={i}
            aria-label={`Enlarge photo ${i + 1}`}
          >
            <img
              src={src}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
          </button>
        ))}
      </div>
    </div>

    <!-- Lightbox -->
    <div class="lightbox fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4 md:p-10">
      <button class="lightbox-close absolute top-5 right-6 text-white/80 hover:text-white text-4xl leading-none" aria-label="Close">&times;</button>
      <button class="lightbox-prev absolute left-4 md:left-8 text-white/80 hover:text-white text-5xl leading-none" aria-label="Previous">&lsaquo;</button>
      <img class="lightbox-img max-h-[88vh] max-w-[92vw] rounded-xl object-contain shadow-2xl" src="" alt="" />
      <button class="lightbox-next absolute right-4 md:right-8 text-white/80 hover:text-white text-5xl leading-none" aria-label="Next">&rsaquo;</button>
    </div>
  </section>
)}

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('section:has(.strip)').forEach((root) => {
    const strip = root.querySelector<HTMLElement>('.strip');
    if (!strip) return;
    const items = Array.from(strip.querySelectorAll<HTMLElement>('.strip-item'));
    const srcs = items.map((it) => it.querySelector('img')?.src || '');

    const step = () => {
      const first = items[0];
      if (!first) return 240;
      const gap = parseFloat(getComputedStyle(strip).columnGap || '20') || 20;
      return first.offsetWidth + gap;
    };

    // Arrows
    root.querySelector('.strip-next')?.addEventListener('click', () => {
      strip.scrollBy({ left: step(), behavior: 'smooth' });
      restart();
    });
    root.querySelector('.strip-prev')?.addEventListener('click', () => {
      strip.scrollBy({ left: -step(), behavior: 'smooth' });
      restart();
    });

    // Slow auto-advance
    let timer: number | undefined;
    let paused = false;
    const tick = () => {
      if (paused) return;
      const atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
      if (atEnd) strip.scrollTo({ left: 0, behavior: 'smooth' });
      else strip.scrollBy({ left: step(), behavior: 'smooth' });
    };
    const start = () => { if (items.length > 1) timer = window.setInterval(tick, 3500); };
    const stop = () => { if (timer) window.clearInterval(timer); };
    const restart = () => { stop(); start(); };

    strip.addEventListener('mouseenter', () => (paused = true));
    strip.addEventListener('mouseleave', () => (paused = false));

    // Lightbox
    const lightbox = root.querySelector<HTMLElement>('.lightbox');
    const lbImg = root.querySelector<HTMLImageElement>('.lightbox-img');
    let lbIndex = 0;

    const openLightbox = (i: number) => {
      lbIndex = i;
      if (lbImg) lbImg.src = srcs[i];
      lightbox?.classList.remove('hidden');
      lightbox?.classList.add('flex');
      paused = true;
    };
    const closeLightbox = () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
      paused = false;
    };
    const lbShow = (i: number) => {
      lbIndex = (i + srcs.length) % srcs.length;
      if (lbImg) lbImg.src = srcs[lbIndex];
    };

    items.forEach((it, i) => it.addEventListener('click', () => openLightbox(i)));
    root.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
    root.querySelector('.lightbox-next')?.addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIndex + 1); });
    root.querySelector('.lightbox-prev')?.addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIndex - 1); });
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') lbShow(lbIndex + 1);
      if (e.key === 'ArrowLeft') lbShow(lbIndex - 1);
    });

    start();
  });
</script>
