---
import fs from 'node:fs';
import path from 'node:path';

// Auto-load every image dropped into public/images/carousel/
const dir = path.join(process.cwd(), 'public', 'images', 'carousel');
let files: string[] = [];
try {
  files = fs
    .readdirSync(dir)
    .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
} catch {
  files = [];
}
const images = files.map((f) => `/images/carousel/${encodeURIComponent(f)}`);
---

{images.length > 0 && (
  <section class="relative w-full bg-warm-900">
    <div id="carousel" class="carousel relative w-full h-[60vh] md:h-[82vh] overflow-hidden">
      {images.map((src, i) => (
        <img
          src={src}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          class="carousel-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          style={`opacity:${i === 0 ? 1 : 0}`}
          data-index={i}
        />
      ))}

      <!-- subtle edge vignette for control legibility -->
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-warm-900/30 via-transparent to-warm-900/10"></div>

      {images.length > 1 && (
        <>
          <button
            class="carousel-prev group absolute left-4 md:left-6 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-11 h-11 rounded-full bg-white/15 backdrop-blur-sm text-white text-2xl hover:bg-white/30 transition"
            aria-label="Previous photo"
          >
            <span class="-mt-0.5">&lsaquo;</span>
          </button>
          <button
            class="carousel-next group absolute right-4 md:right-6 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-11 h-11 rounded-full bg-white/15 backdrop-blur-sm text-white text-2xl hover:bg-white/30 transition"
            aria-label="Next photo"
          >
            <span class="-mt-0.5">&rsaquo;</span>
          </button>

          <div class="carousel-dots absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2.5">
            {images.map((_, i) => (
              <button class="carousel-dot" data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
)}

<style>
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.5);
    transition: width 0.4s ease, background 0.4s ease;
  }
  .carousel-dot.is-active {
    width: 26px;
    background: #fff;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.carousel-dot'));
    if (slides.length < 2) {
      dots[0]?.classList.add('is-active');
      return;
    }

    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, k) => (s.style.opacity = k === current ? '1' : '0'));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === current));
    };

    const start = () => {
      stop();
      timer = window.setInterval(() => show(current + 1), 5500);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
    };

    root.querySelector('.carousel-next')?.addEventListener('click', () => {
      show(current + 1);
      start();
    });
    root.querySelector('.carousel-prev')?.addEventListener('click', () => {
      show(current - 1);
      start();
    });
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    show(0);
    start();
  });
</script>
