---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Education" description="Spreading Montessori Education for Adolescents — because they need these non-traditional learning environments now more than ever.">
  <div class="pt-20"></div>

  <section class="py-24 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl text-warm-800 mb-6">
        Spreading Montessori Education for Adolescents
      </h1>
      <p class="font-body text-warm-600 text-lg md:text-xl leading-relaxed mb-16">
        Because they need these non-traditional learning environments now more than ever.
      </p>

      <div class="flex flex-col items-center gap-6">
        <img
          src="/images/montessori-logo.png"
          alt="Montessori logo"
          class="h-24 w-auto"
        />
        <a
          href="https://www.montessoriforadolescents.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 bg-warm-700 text-white font-body text-sm tracking-wider uppercase rounded-md hover:bg-warm-800 transition-colors"
        >
          Learn More
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
