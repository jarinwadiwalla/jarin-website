---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Connect" description="Get in touch with Jarin Wadiwalla for sound healing sessions, community circles, or general inquiries.">
  <Hero
    image="/images/contact-hero.jpg"
    imageAlt="Connect with Jarin Wadiwalla"
    overlay={false}
  />

  <!-- Contact form -->
  <section class="py-24 px-6 bg-warm-50">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <img src="/images/lotus-icon.png" alt="" aria-hidden="true" class="h-12 w-auto mx-auto mb-5 opacity-80" />
        <h2 class="text-5xl md:text-6xl italic text-warm-800 mb-3">Get in Touch</h2>
        <p class="font-body text-warm-600 max-w-md mx-auto leading-relaxed">
          Whether you're drawn to sound, to circle, or simply curious — I'd love to hear from you.
        </p>
        <div class="w-16 h-px bg-warm-300 mx-auto mt-7"></div>
      </div>
      <div class="bg-white rounded-3xl shadow-[0_10px_50px_rgba(120,90,60,0.10)] border border-warm-100 p-8 md:p-12">
        <ContactForm />
      </div>
    </div>
  </section>

</BaseLayout>
