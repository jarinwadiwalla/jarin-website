---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<BaseLayout title="Home">
  <Hero
    image="/images/IMG_3783.JPG"
    imageAlt="Jarin Wadiwalla — sound healing and wellness"
    video="/images/IMG_3781.MOV"
    title="Support for the lifelong unfolding of the human spirit"
    subtitle="through Acutonics vibrational sound therapy and community."
  />


  <!-- Three pillars -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-12 text-center">

      <a href="/sound" class="group flex flex-col items-center gap-4 hover:opacity-80 transition-opacity">
        <img src="/images/lotus-icon.png" alt="" aria-hidden="true" class="h-12 w-auto opacity-70 group-hover:opacity-100 transition-opacity" />
        <h2 class="text-2xl text-warm-800">Sound</h2>
        <p class="font-body text-warm-600 text-sm leading-relaxed">
          Acutonics vibrational sound therapy — like acupuncture but with activated tuning forks. Needle-free, effective, grounding.
        </p>
      </a>

      <a href="/community" class="group flex flex-col items-center gap-4 hover:opacity-80 transition-opacity">
        <img src="/images/lotus-icon.png" alt="" aria-hidden="true" class="h-12 w-auto opacity-70 group-hover:opacity-100 transition-opacity" />
        <h2 class="text-2xl text-warm-800">Community</h2>
        <p class="font-body text-warm-600 text-sm leading-relaxed">
          Community-centered grief work and gathering spaces for the heart.
        </p>
      </a>

      <a href="/education" class="group flex flex-col items-center gap-4 hover:opacity-80 transition-opacity">
        <img src="/images/lotus-icon.png" alt="" aria-hidden="true" class="h-12 w-auto opacity-70 group-hover:opacity-100 transition-opacity" />
        <h2 class="text-2xl text-warm-800">Education</h2>
        <p class="font-body text-warm-600 text-sm leading-relaxed">
          Whole-human development across the lifespan, rooted in Montessori philosophy and integrative wellness.
        </p>
      </a>

    </div>
  </section>

  <!-- Newsletter section -->
  <section class="py-20 px-6 bg-warm-100">
    <div class="max-w-xl mx-auto text-center">
      <NewsletterSignup />
    </div>
  </section>
</BaseLayout>
