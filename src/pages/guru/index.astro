    <script>
      // ═══════════════════ TAB SWITCHING ═══════════════════
      const tabs = document.querySelectorAll('.tab-btn');
      const panels = document.querySelectorAll('.panel');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          panels.forEach(p => p.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
          // Load data on tab switch
          const t = tab.dataset.tab;
          if (t === 'finances') loadFinances();
          else if (t === 'blog') { loadDrafts(); loadPosts(); }
          else if (t === 'newsletter') loadSubscribers();
          else if (t === 'notes') loadNotes();
          else if (t === 'habits') loadHabits();
          else if (t === 'todos') loadTodos();
          else if (t === 'intentions') loadIntentions();
          else if (t === 'office-work') loadOfficeWork();
        });
      });

      function showStatus(elId, msg, type = 'success') {
        const el = document.getElementById(elId);
        if (!el) return;
        el.innerHTML = `<div class="status status-${type}">${msg}</div>`;
        setTimeout(() => el.innerHTML = '', 4000);
      }

      // ═══════════════════ FINANCES ═══════════════════
      let finEntries = [];
      let currentFinMode = 'analysis';
      let finExpMonthFilter = '', finIncMonthFilter = '', finBizMonthFilter = '';

      // Finance sub-tab switching
      document.querySelectorAll('.fin-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.fin-tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.fin-panel').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          currentFinMode = btn.dataset.fin;
          document.getElementById('fin-panel-' + currentFinMode).classList.add('active');
          if (currentFinMode === 'analysis') renderAnalysis();
        });
      });

      async function loadFinances() {
        try {
          const res = await fetch('/api/finances');
          const data = await res.json();
          finEntries = data.entries || [];
          renderAllFinances();
        } catch { showStatus('finance-status', 'Failed to load finances.', 'error'); }
      }

      function renderAllFinances() {
        renderExpenses();
        renderIncome();
        renderBusiness();
        if (currentFinMode === 'analysis') renderAnalysis();
      }

      // ── IDR conversion ──
      window.finConvertUsdToIdr = function() {
        const usd = parseFloat(document.getElementById('fin-exp-usd').value);
        const rate = parseFloat(document.getElementById('fin-exp-rate').value) || 15800;
        if (!isNaN(usd)) document.getElementById('fin-exp-idr').value = Math.round(usd * rate);
      };
      window.finConvertIdrToUsd = function() {
        const idr = parseFloat(document.getElementById('fin-exp-idr').value);
        const rate = parseFloat(document.getElementById('fin-exp-rate').value) || 15800;
        if (!isNaN(idr)) document.getElementById('fin-exp-usd').value = (idr / rate).toFixed(2);
      };

      // ── Business date toggle ──
      window.toggleBizDate = function() {
        const freq = document.getElementById('biz-freq').value;
        document.getElementById('biz-recurring-group').style.display = freq === 'one-time' ? 'none' : '';
        document.getElementById('biz-date-group').style.display = freq === 'one-time' ? '' : 'none';
      };

      // ── Month button builder ──
      function buildMonthBtns(entries, containerId, filterVar, setFn) {
        const months = {};
        let undatedCount = 0;
        entries.forEach(e => {
          const m = (e.date || '').slice(0, 7);
          if (m) months[m] = (months[m] || 0) + 1;
          else undatedCount++;
        });
        const sorted = Object.keys(months).sort().reverse();
        const el = document.getElementById(containerId);
        if (sorted.length <= 1 && undatedCount === 0) { el.innerHTML = ''; return; }
        const current = filterVar || '';
        const allCount = entries.length;
        let html = `<button class="month-btn ${!current ? 'active' : ''}" onclick="${setFn}('')">All (${allCount})</button>`;
        html += sorted.map(m => {
          const label = m.slice(5) + '/' + m.slice(2, 4);
          return `<button class="month-btn ${current === m ? 'active' : ''}" onclick="${setFn}('${m}')">${label} (${months[m]})</button>`;
        }).join('');
        if (undatedCount > 0) {
          html += `<button class="month-btn ${current === 'undated' ? 'active' : ''}" onclick="${setFn}('undated')">Undated (${undatedCount})</button>`;
        }
        el.innerHTML = html;
      }

      // ── EXPENSES ──
      window.setExpMonth = function(m) { finExpMonthFilter = m; renderExpenses(); };

      function renderExpenses() {
        const exp = finEntries.filter(e => e.kind === 'expense');
        const thisMonth = new Date().toISOString().slice(0, 7);

        // Summary for current display
        const displayMonth = finExpMonthFilter && finExpMonthFilter !== 'undated' ? finExpMonthFilter : thisMonth;
        const monthExp = exp.filter(e => (e.date || '').startsWith(displayMonth));
        const monthUSD = monthExp.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        document.getElementById('fin-exp-month-usd').textContent = '$' + monthUSD.toFixed(2);
        document.getElementById('fin-exp-month-count').textContent = monthExp.length;

        // Month buttons
        buildMonthBtns(exp, 'fin-exp-months', finExpMonthFilter, 'setExpMonth');

        // Filter
        let filtered;
        if (finExpMonthFilter === 'undated') filtered = exp.filter(e => !e.date);
        else if (finExpMonthFilter) filtered = exp.filter(e => (e.date || '').startsWith(finExpMonthFilter));
        else filtered = exp;

        // Sort: dated entries descending, undated at bottom
        filtered.sort((a, b) => {
          if (a.date && b.date) return b.date.localeCompare(a.date);
          if (a.date && !b.date) return -1;
          if (!a.date && b.date) return 1;
          return 0;
        });

        const el = document.getElementById('fin-exp-list');
        const foot = document.getElementById('fin-exp-foot');
        if (filtered.length === 0) {
          el.innerHTML = '<tr><td colspan="5"><div class="empty"><p>No expenses for this period.</p></div></td></tr>';
          foot.innerHTML = '';
          return;
        }
        el.innerHTML = filtered.map(e => {
          const cc = catColor(e.category || 'Other');
          return `<tr>
          <td>${e.date ? e.date : '<span class="no-date">no date</span>'}</td>
          <td style="color:#c53030;font-weight:600;">$${parseFloat(e.price || 0).toFixed(2)}</td>
          <td>${esc(e.product)}</td>
          <td><span class="cat-badge" style="background:${cc.bg};color:${cc.text};">${esc(e.category || 'Other')}</span></td>
          <td><button class="btn btn-danger btn-sm" onclick="deleteFinance('${e.id}')">Del</button></td>
        </tr>`;
        }).join('');
        const totalUSD = filtered.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        foot.innerHTML = `<tr><td>${filtered.length} entries</td><td style="color:#c53030;">$${totalUSD.toFixed(2)}</td><td colspan="3"></td></tr>`;
      }

      // ── INCOME ──
      window.setIncMonth = function(m) { finIncMonthFilter = m; renderIncome(); };

      function renderIncome() {
        const inc = finEntries.filter(e => e.kind === 'income');
        const thisMonth = new Date().toISOString().slice(0, 7);
        const displayMonth = finIncMonthFilter && finIncMonthFilter !== 'undated' ? finIncMonthFilter : thisMonth;

        const monthInc = inc.filter(e => (e.date || '').startsWith(displayMonth));
        const monthTotal = monthInc.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        const allTotal = inc.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        document.getElementById('fin-inc-month-total').textContent = '$' + monthTotal.toFixed(2);
        document.getElementById('fin-inc-all-total').textContent = '$' + allTotal.toFixed(2);
        document.getElementById('fin-inc-month-label').textContent = displayMonth || 'This Month';

        buildMonthBtns(inc, 'fin-inc-months', finIncMonthFilter, 'setIncMonth');

        let filtered;
        if (finIncMonthFilter === 'undated') filtered = inc.filter(e => !e.date);
        else if (finIncMonthFilter) filtered = inc.filter(e => (e.date || '').startsWith(finIncMonthFilter));
        else filtered = inc;

        const el = document.getElementById('fin-inc-list');
        if (filtered.length === 0) { el.innerHTML = '<tr><td colspan="6"><div class="empty"><p>No income for this period.</p></div></td></tr>'; return; }
        el.innerHTML = filtered.map(e => `<tr>
          <td>${e.date ? e.date : '<span class="no-date">no date</span>'}</td>
          <td style="color:var(--color-sage-600);font-weight:600;">$${parseFloat(e.price || 0).toFixed(2)}</td>
          <td>${esc(e.product)}</td>
          <td><span class="cat-badge">${esc(e.category || 'other')}</span></td>
          <td>${esc(e.company || '')}</td>
          <td><button class="btn btn-danger btn-sm" onclick="deleteFinance('${e.id}')">Del</button></td>
        </tr>`).join('');
      }

      // ── BUSINESS ──
      window.setBizMonth = function(m) { finBizMonthFilter = m; renderBusiness(); };

      function renderBusiness() {
        const biz = finEntries.filter(e => (e.kind || 'business') === 'business');
        const bizMonthly = biz.filter(e => e.frequency === 'monthly');
        const bizYearly = biz.filter(e => e.frequency === 'yearly');
        // Fix: capture both (kind=expense && category=business) AND (kind=business && frequency=one-time)
        const oneTime = finEntries.filter(e =>
          (e.kind === 'expense' && e.category === 'business') ||
          (e.kind === 'business' && e.frequency === 'one-time')
        );

        const moTotal = bizMonthly.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        const yrTotal = bizYearly.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        const otAllTotal = oneTime.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        document.getElementById('fin-biz-monthly').textContent = '$' + moTotal.toFixed(2);
        document.getElementById('fin-biz-yearly').textContent = '$' + yrTotal.toFixed(2);
        document.getElementById('fin-biz-onetime-total').textContent = '$' + otAllTotal.toFixed(2);
        document.getElementById('fin-biz-annual').textContent = '$' + ((moTotal * 12) + yrTotal).toFixed(2);

        // Monthly recurring table
        const moEl = document.getElementById('fin-biz-monthly-list');
        moEl.innerHTML = bizMonthly.length === 0 ? '<tr><td colspan="6"><div class="empty"><p>No monthly recurring expenses.</p></div></td></tr>' :
          bizMonthly.map(e => `<tr><td>$${parseFloat(e.price || 0).toFixed(2)}</td><td>${esc(e.product)}</td><td>${esc(e.company || '')}</td><td>${esc(e.businessUseCase || '')}</td><td>${esc(e.recurringDate || '')}</td><td><button class="btn btn-danger btn-sm" onclick="deleteFinance('${e.id}')">Del</button></td></tr>`).join('');

        // Yearly recurring table
        const yrEl = document.getElementById('fin-biz-yearly-list');
        yrEl.innerHTML = bizYearly.length === 0 ? '<tr><td colspan="6"><div class="empty"><p>No yearly recurring expenses.</p></div></td></tr>' :
          bizYearly.map(e => `<tr><td>$${parseFloat(e.price || 0).toFixed(2)}</td><td>${esc(e.product)}</td><td>${esc(e.company || '')}</td><td>${esc(e.businessUseCase || '')}</td><td>${esc(e.recurringDate || '')}</td><td><button class="btn btn-danger btn-sm" onclick="deleteFinance('${e.id}')">Del</button></td></tr>`).join('');

        // One-time business expenses
        buildMonthBtns(oneTime, 'fin-biz-months', finBizMonthFilter, 'setBizMonth');
        let filteredOT;
        if (finBizMonthFilter === 'undated') filteredOT = oneTime.filter(e => !e.date);
        else if (finBizMonthFilter) filteredOT = oneTime.filter(e => (e.date || '').startsWith(finBizMonthFilter));
        else filteredOT = oneTime;

        const otEl = document.getElementById('fin-biz-onetime-list');
        if (filteredOT.length === 0) { otEl.innerHTML = '<tr><td colspan="5"><div class="empty"><p>No one-time business expenses.</p></div></td></tr>'; return; }
        const otFilteredTotal = filteredOT.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        otEl.innerHTML = filteredOT.map(e => `<tr><td>${e.date ? e.date : '<span class="no-date">no date</span>'}</td><td>$${parseFloat(e.price || 0).toFixed(2)}</td><td>${esc(e.product)}</td><td>${esc(e.company || '')}</td><td><button class="btn btn-danger btn-sm" onclick="deleteFinance('${e.id}')">Del</button></td></tr>`).join('') +
          `<tr style="font-weight:600;border-top:2px solid var(--color-warm-200);"><td></td><td>$${otFilteredTotal.toFixed(2)}</td><td colspan="3">Total (${filteredOT.length} entries)</td></tr>`;
      }

      // ── ANALYSIS ──
      document.getElementById('fin-analysis-month').value = new Date().toISOString().slice(0, 7);
      document.getElementById('fin-analysis-month').addEventListener('change', renderAnalysis);
      document.getElementById('fin-analysis-all').addEventListener('click', () => {
        document.getElementById('fin-analysis-month').value = '';
        renderAnalysis();
      });

      const CATEGORY_COLORS = {
        'Bills':          { bg: '#fef3c7', text: '#92400e', fill: '#d97706' },
        'Coffee Shop':    { bg: '#f5e6d3', text: '#7d5f52', fill: '#a18072' },
        'Data':           { bg: '#e0e7ff', text: '#3730a3', fill: '#6366f1' },
        'Debt':           { bg: '#fee2e2', text: '#991b1b', fill: '#dc2626' },
        'Dining Out':     { bg: '#fce7f3', text: '#9d174d', fill: '#db2777' },
        'Electricity':    { bg: '#fef9c3', text: '#854d0e', fill: '#ca8a04' },
        'Extras':         { bg: '#f3e8ff', text: '#6b21a8', fill: '#9333ea' },
        'Fitness':        { bg: '#d1fae5', text: '#065f46', fill: '#059669' },
        'Gojek':          { bg: '#dcfce7', text: '#166534', fill: '#16a34a' },
        'Groceries':      { bg: '#e8eadc', text: '#434d37', fill: '#576447' },
        'Laundry':        { bg: '#e0f2fe', text: '#075985', fill: '#0284c7' },
        'Self-Care':      { bg: '#fae8ff', text: '#86198f', fill: '#c026d3' },
        'Shopping':       { bg: '#ffe4e6', text: '#9f1239', fill: '#e11d48' },
        'Transportation': { bg: '#f0fdf4', text: '#14532d', fill: '#15803d' },
        'Business':       { bg: '#eff6ff', text: '#1e40af', fill: '#2563eb' },
        'KL Trip':        { bg: '#fdf2f8', text: '#7c3aed', fill: '#8b5cf6' },
        'Travel':         { bg: '#ecfeff', text: '#155e75', fill: '#0891b2' },
        'Other':          { bg: '#f5f5f4', text: '#57534e', fill: '#78716c' },
      };
      const FALLBACK_CAT = { bg: '#f5f5f4', text: '#57534e', fill: '#78716c' };
      function catColor(cat) { return CATEGORY_COLORS[cat] || FALLBACK_CAT; }

      function renderAnalysis() {
        const monthFilter = document.getElementById('fin-analysis-month').value || '';
        const allExp = finEntries.filter(e => e.kind === 'expense');
        const exp = allExp.filter(e => !monthFilter || (e.date || '').startsWith(monthFilter));
        const inc = finEntries.filter(e => e.kind === 'income' && (!monthFilter || (e.date || '').startsWith(monthFilter)));

        const expTotal = exp.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        const incTotal = inc.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
        const net = incTotal - expTotal;

        // Summary cards
        document.getElementById('fin-analysis-summary').innerHTML = `
          <div class="summary-card"><div class="label">Total Expenses</div><div class="value negative">$${expTotal.toFixed(2)}</div></div>
          <div class="summary-card"><div class="label">Total Income</div><div class="value positive">$${incTotal.toFixed(2)}</div></div>
          <div class="summary-card"><div class="label">Net</div><div class="value ${net >= 0 ? 'positive' : 'negative'}">$${net.toFixed(2)}</div></div>
          <div class="summary-card"><div class="label">Entries</div><div class="value">${exp.length + inc.length}</div></div>`;

        let html = '';

        // ── Donut chart + category bars ──
        if (exp.length > 0) {
          const byCat = {};
          exp.forEach(e => { const c = e.category || 'Other'; byCat[c] = (byCat[c] || 0) + (parseFloat(e.price) || 0); });
          const sorted = Object.entries(byCat).sort((a, b) => b[1] - a[1]);

          // Separate outliers: category > $500 AND > 40% of total
          const outliers = sorted.filter(([, total]) => total > 500 && (total / expTotal) > 0.4);
          const everyday = outliers.length > 0 ? sorted.filter(([, total]) => !(total > 500 && (total / expTotal) > 0.4)) : sorted;
          const everydayTotal = everyday.reduce((s, [, t]) => s + t, 0);
          const outlierTotal = outliers.reduce((s, [, t]) => s + t, 0);

          // Show outlier callout if any
          if (outliers.length > 0) {
            html += '<h2 style="margin-top:24px;">Large Expenses</h2>';
            html += '<div class="mom-card">';
            outliers.forEach(([cat, total]) => {
              const cc = catColor(cat);
              html += `<div class="mom-stat"><div class="label">${cat}</div><div class="value negative" style="font-size:20px;">$${total.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</div></div>`;
            });
            html += `<div class="mom-stat"><div class="label">Day-to-Day</div><div class="value" style="font-size:20px;">$${everydayTotal.toFixed(2)}</div></div>`;
            html += '</div>';
          }

          // Donut uses everyday categories only (or all if no outliers)
          const donutCats = everyday;
          const donutTotal = outliers.length > 0 ? everydayTotal : expTotal;
          const maxCat = donutCats[0]?.[1] || 1;

          // Build conic-gradient
          let angle = 0;
          const gradParts = [];
          donutCats.forEach(([cat, total]) => {
            const cc = catColor(cat);
            const slice = (total / donutTotal) * 360;
            gradParts.push(`${cc.fill} ${angle}deg ${angle + slice}deg`);
            angle += slice;
          });
          const gradient = `conic-gradient(${gradParts.join(', ')})`;

          // Legend
          const legendItems = donutCats.map(([cat, total]) => {
            const cc = catColor(cat);
            const pct = ((total / donutTotal) * 100).toFixed(0);
            return `<div class="donut-legend-item"><div class="donut-legend-swatch" style="background:${cc.fill};"></div><span>${cat}</span><span class="donut-legend-pct">${pct}%</span></div>`;
          }).join('');

          const donutLabel = outliers.length > 0 ? 'Day-to-Day' : 'Total';
          html += `<h2 style="margin-top:24px;">Expense Categories${outliers.length > 0 ? ' (excl. large)' : ''}</h2>`;
          html += `<div class="donut-wrap">
            <div class="donut" style="background:${gradient};">
              <div class="donut-hole"><div class="donut-total">$${donutTotal.toFixed(0)}</div><div class="donut-label">${donutLabel}</div></div>
            </div>
            <div class="donut-legend">${legendItems}</div>
          </div>`;

          // Category bars with per-category colors (everyday only)
          donutCats.forEach(([cat, total]) => {
            const cc = catColor(cat);
            const pct = ((total / donutTotal) * 100).toFixed(0);
            html += `<div class="bar-row"><div class="bar-label">${cat}</div><div class="bar-track"><div class="bar-fill" style="width:${(total/maxCat)*100}%;background:${cc.fill};"></div></div><div class="bar-value">$${total.toFixed(0)} (${pct}%)</div></div>`;
          });
        }

        // ── Month-over-month card (when viewing a specific month) ──
        if (monthFilter && exp.length > 0) {
          const avgPerEntry = expTotal / exp.length;
          const topCat = Object.entries(exp.reduce((acc, e) => { const c = e.category || 'Other'; acc[c] = (acc[c] || 0) + (parseFloat(e.price) || 0); return acc; }, {})).sort((a, b) => b[1] - a[1])[0];

          // Previous month
          const [yr, mo] = monthFilter.split('-').map(Number);
          const prevMo = mo === 1 ? `${yr-1}-12` : `${yr}-${String(mo-1).padStart(2,'0')}`;
          const prevExp = allExp.filter(e => (e.date || '').startsWith(prevMo));
          const prevTotal = prevExp.reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
          const pctChange = prevTotal > 0 ? (((expTotal - prevTotal) / prevTotal) * 100).toFixed(0) : null;

          html += '<h2 style="margin-top:24px;">Month Summary</h2>';
          html += '<div class="mom-card">';
          html += `<div class="mom-stat"><div class="label">Total</div><div class="value">$${expTotal.toFixed(0)}</div></div>`;
          html += `<div class="mom-stat"><div class="label">Entries</div><div class="value">${exp.length}</div></div>`;
          html += `<div class="mom-stat"><div class="label">Avg/Entry</div><div class="value">$${avgPerEntry.toFixed(0)}</div></div>`;
          if (topCat) html += `<div class="mom-stat"><div class="label">Top Category</div><div class="value" style="font-size:16px;">${topCat[0]}</div></div>`;
          if (pctChange !== null) {
            const cls = Number(pctChange) > 0 ? 'change-up' : 'change-down';
            const arrow = Number(pctChange) > 0 ? '\u2191' : '\u2193';
            html += `<div class="mom-stat"><div class="label">vs ${prevMo}</div><div class="value ${cls}">${arrow} ${Math.abs(pctChange)}%</div></div>`;
          }
          html += '</div>';
        }

        // ── Monthly spend trend ──
        if (allExp.length > 0) {
          const byMonth = {};
          allExp.forEach(e => {
            const m = (e.date || '').slice(0, 7);
            if (m) byMonth[m] = (byMonth[m] || 0) + (parseFloat(e.price) || 0);
          });
          const monthsSorted = Object.keys(byMonth).sort();
          if (monthsSorted.length > 1) {
            const maxMonth = Math.max(...Object.values(byMonth));
            html += '<h2 style="margin-top:24px;">Monthly Spend Trend</h2>';
            monthsSorted.forEach(m => {
              const total = byMonth[m];
              const label = m.slice(5) + '/' + m.slice(2, 4);
              const isActive = m === monthFilter;
              const fillColor = isActive ? 'var(--color-sage-700)' : 'var(--color-sage-400)';
              html += `<div class="trend-row"><div class="trend-month">${label}</div><div class="trend-track"><div class="trend-fill" style="width:${(total/maxMonth)*100}%;background:${fillColor};"></div><div class="trend-value">$${total.toFixed(0)}</div></div></div>`;
            });
          }
        }

        // ── Top Expenses (by product field) ──
        if (exp.length > 0) {
          const byProduct = {};
          exp.forEach(e => { const p = e.product || 'Unknown'; byProduct[p] = (byProduct[p] || 0) + (parseFloat(e.price) || 0); });
          const topP = Object.entries(byProduct).sort((a, b) => b[1] - a[1]).slice(0, 15);
          html += '<h2 style="margin-top:24px;">Top Expenses</h2><table class="compact-table"><thead><tr><th>#</th><th>Item</th><th>Total</th><th>%</th></tr></thead><tbody>';
          topP.forEach(([p, total], i) => {
            html += `<tr><td>${i+1}</td><td>${esc(p)}</td><td>$${total.toFixed(2)}</td><td>${((total/expTotal)*100).toFixed(0)}%</td></tr>`;
          });
          html += '</tbody></table>';
        }

        // ── Income by category ──
        if (inc.length > 0) {
          const byCat = {};
          inc.forEach(e => { const c = e.category || 'other'; byCat[c] = (byCat[c] || 0) + (parseFloat(e.price) || 0); });
          const sorted = Object.entries(byCat).sort((a, b) => b[1] - a[1]);
          const maxCat = sorted[0]?.[1] || 1;
          html += '<h2 style="margin-top:24px;">Income Categories</h2>';
          sorted.forEach(([cat, total]) => {
            const pct = ((total / incTotal) * 100).toFixed(0);
            html += `<div class="bar-row"><div class="bar-label">${cat}</div><div class="bar-track"><div class="bar-fill" style="width:${(total/maxCat)*100}%;background:var(--color-sage-500);"></div></div><div class="bar-value">$${total.toFixed(0)} (${pct}%)</div></div>`;
          });
        }

        // ── Business overhead ──
        const biz = finEntries.filter(e => (e.kind || 'business') === 'business');
        if (biz.length > 0) {
          const bizMo = biz.filter(e => e.frequency === 'monthly').reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
          const bizYr = biz.filter(e => e.frequency === 'yearly').reduce((s, e) => s + (parseFloat(e.price) || 0), 0);
          const annual = (bizMo * 12) + bizYr;
          html += `<h2 style="margin-top:24px;">Business Overhead</h2><p style="font-size:14px;color:var(--color-warm-600);">Monthly: $${bizMo.toFixed(2)} &middot; Yearly: $${bizYr.toFixed(2)} &middot; <strong>Annual: $${annual.toFixed(2)}</strong></p>`;
        }

        if (!exp.length && !inc.length) html = '<div class="empty"><p>No data for this period.</p></div>';
        document.getElementById('fin-analysis-content').innerHTML = html;
      }

      // ── Finance form handlers ──
      function setupFinForm(formId, kind) {
        const form = document.getElementById(formId);
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const fd = new FormData(form);
          const body = Object.fromEntries(fd);
          if (!body.id) delete body.id;
          // For one-time business, keep kind=business with frequency=one-time
          if (kind === 'business' && body.frequency === 'one-time') {
            body.kind = 'business';
          }
          try {
            const res = await fetch('/api/finances', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            if (res.ok) { showStatus('finance-status', 'Saved!'); form.reset(); if (kind === 'business') toggleBizDate(); loadFinances(); }
            else showStatus('finance-status', 'Failed to save.', 'error');
          } catch { showStatus('finance-status', 'Network error.', 'error'); }
        });
      }
      setupFinForm('exp-form', 'expense');
      setupFinForm('inc-form', 'income');
      setupFinForm('biz-form', 'business');

      window.deleteFinance = async function(id) {
        if (!confirm('Delete this entry?')) return;
        await fetch('/api/finances', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        loadFinances();
      };

      // ═══════════════════ BLOG ═══════════════════
      const blogForm = document.getElementById('blog-form');

      async function loadDrafts() {
        try {
          const res = await fetch('/api/blog-drafts');
          const data = await res.json();
          const drafts = data.drafts || [];
          const el = document.getElementById('blog-drafts-list');
          if (drafts.length === 0) { el.innerHTML = '<div class="empty"><p>No drafts.</p></div>'; return; }
          el.innerHTML = drafts.map(d => `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--color-warm-100);">
            <div><strong>${esc(d.title)}</strong> <span style="color:var(--color-warm-400);font-size:13px;">${d.slug}</span></div>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-ghost btn-sm" onclick="editDraft('${esc(d.slug)}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="deleteDraft('${esc(d.slug)}')">Del</button>
            </div>
          </div>`).join('');
        } catch { document.getElementById('blog-drafts-list').innerHTML = '<div class="empty"><p>Failed to load.</p></div>'; }
      }

      async function loadPosts() {
        try {
          const res = await fetch('/api/blog-posts');
          const data = await res.json();
          const posts = data.posts || [];
          const el = document.getElementById('blog-posts-list');
          if (posts.length === 0) { el.innerHTML = '<div class="empty"><p>No published posts.</p></div>'; return; }
          el.innerHTML = posts.map(p => `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--color-warm-100);">
            <div><strong>${esc(p.title)}</strong> <span style="color:var(--color-warm-400);font-size:13px;">${p.date}</span></div>
            <button class="btn btn-danger btn-sm" onclick="deletePost('${esc(p.slug)}')">Del</button>
          </div>`).join('');
        } catch { document.getElementById('blog-posts-list').innerHTML = '<div class="empty"><p>Failed to load.</p></div>'; }
      }

      blogForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(blogForm);
        const draft = Object.fromEntries(fd);
        try {
          const res = await fetch('/api/blog-drafts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ draft }) });
          if (res.ok) { showStatus('blog-status', 'Draft saved!'); loadDrafts(); }
          else showStatus('blog-status', 'Failed to save draft.', 'error');
        } catch { showStatus('blog-status', 'Network error.', 'error'); }
      });

      document.getElementById('blog-publish-btn').addEventListener('click', async () => {
        const slug = blogForm.slug.value;
        if (!slug) { showStatus('blog-status', 'Enter a slug first.', 'error'); return; }
        if (!confirm('Publish this post?')) return;
        try {
          const fd = new FormData(blogForm);
          const body = Object.fromEntries(fd);
          const res = await fetch('/api/blog-publish', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { showStatus('blog-status', 'Published!'); blogForm.reset(); loadDrafts(); loadPosts(); }
          else { const d = await res.json(); showStatus('blog-status', d.error || 'Publish failed.', 'error'); }
        } catch { showStatus('blog-status', 'Network error.', 'error'); }
      });

      document.getElementById('blog-clear').addEventListener('click', () => blogForm.reset());

      window.editDraft = async function(slug) {
        try {
          const res = await fetch('/api/blog-drafts');
          const data = await res.json();
          const d = (data.drafts || []).find(x => x.slug === slug);
          if (!d) return;
          blogForm.title.value = d.title;
          blogForm.slug.value = d.slug;
          blogForm.date.value = d.date || '';
          blogForm.image.value = d.image || '';
          blogForm.excerpt.value = d.excerpt || '';
          blogForm.body.value = d.body || '';
        } catch {}
      };

      window.deleteDraft = async function(slug) {
        if (!confirm('Delete this draft?')) return;
        await fetch('/api/blog-drafts', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) });
        loadDrafts();
      };

      window.deletePost = async function(slug) {
        if (!confirm('Delete this published post from GitHub?')) return;
        await fetch('/api/blog-posts', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) });
        loadPosts();
      };

      // ═══════════════════ NEWSLETTER ═══════════════════
      const nlForm = document.getElementById('newsletter-form');

      async function loadSubscribers() {
        try {
          const res = await fetch('/api/subscribers');
          const data = await res.json();
          const subs = data.subscribers || [];
          const el = document.getElementById('subscribers-list');
          const active = subs.filter(s => !s.unsubscribed);
          if (active.length === 0) { el.innerHTML = '<div class="empty"><p>No subscribers yet.</p></div>'; return; }
          el.innerHTML = `<p style="margin-bottom:12px;font-size:14px;color:var(--color-warm-600);">${active.length} active subscriber${active.length !== 1 ? 's' : ''}</p>` +
            active.map(s => `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--color-warm-100);">
              <div><strong>${esc(s.firstName)} ${esc(s.lastName)}</strong> <span style="color:var(--color-warm-400);font-size:13px;">${esc(s.email)}</span></div>
              <span style="font-size:12px;color:var(--color-warm-400);">${s.subscribedAt?.slice(0, 10) || ''}</span>
            </div>`).join('');
        } catch { document.getElementById('subscribers-list').innerHTML = '<div class="empty"><p>Failed to load.</p></div>'; }
      }

      document.getElementById('newsletter-test-btn').addEventListener('click', async () => {
        const testEmail = nlForm.testEmail.value;
        if (!testEmail) { showStatus('newsletter-status', 'Enter a test email.', 'error'); return; }
        const subject = nlForm.subject.value;
        const htmlBody = nlForm.htmlBody.value;
        if (!subject || !htmlBody) { showStatus('newsletter-status', 'Subject and body required.', 'error'); return; }
        try {
          const res = await fetch('/api/newsletter-send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subject, htmlBody, testEmails: [testEmail] }) });
          const data = await res.json();
          showStatus('newsletter-status', data.message || 'Test sent!');
        } catch { showStatus('newsletter-status', 'Network error.', 'error'); }
      });

      nlForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (!confirm('Send this newsletter to ALL subscribers?')) return;
        const subject = nlForm.subject.value;
        const htmlBody = nlForm.htmlBody.value;
        try {
          const res = await fetch('/api/newsletter-send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subject, htmlBody }) });
          const data = await res.json();
          if (data.success) showStatus('newsletter-status', data.message);
          else showStatus('newsletter-status', data.message || 'Failed.', 'error');
        } catch { showStatus('newsletter-status', 'Network error.', 'error'); }
      });

      // ═══════════════════ NOTES ═══════════════════
      const noteForm = document.getElementById('note-form');
      let allNotes = [];

      async function loadNotes() {
        try {
          const res = await fetch('/api/notes');
          const data = await res.json();
          allNotes = data.notes || [];
          renderNotes();
        } catch { document.getElementById('notes-list').innerHTML = '<div class="empty"><p>Failed to load.</p></div>'; }
      }

      function renderNotes() {
        const el = document.getElementById('notes-list');
        if (allNotes.length === 0) { el.innerHTML = '<div class="empty"><p>No notes yet.</p></div>'; return; }
        el.innerHTML = allNotes.map(n => `<div class="note-item">
          <input type="checkbox" ${n.completed ? 'checked' : ''} onchange="toggleNote('${n.id}', this.checked)" />
          <span class="note-text ${n.completed ? 'completed' : ''}" ondblclick="startEditNote('${n.id}')" id="note-text-${n.id}">${esc(n.text)}</span>
          <button class="btn btn-danger btn-sm" onclick="deleteNote('${n.id}')" style="flex-shrink:0;">Del</button>
        </div>`).join('');
      }

      noteForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(noteForm);
        const body = { text: fd.get('text'), id: fd.get('id') || undefined };
        if (!body.id) delete body.id;
        try {
          await fetch('/api/notes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          noteForm.reset();
          loadNotes();
        } catch { showStatus('notes-status', 'Failed to save.', 'error'); }
      });

      window.toggleNote = async function(id, completed) {
        const n = allNotes.find(x => x.id === id);
        if (!n) return;
        await fetch('/api/notes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, text: n.text, completed }) });
        loadNotes();
      };

      window.deleteNote = async function(id) {
        if (!confirm('Delete this note?')) return;
        await fetch('/api/notes', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        loadNotes();
      };

      window.startEditNote = function(id) {
        const n = allNotes.find(x => x.id === id);
        if (!n) return;
        noteForm.text.value = n.text;
        noteForm.id.value = n.id;
        noteForm.text.focus();
      };

      // ═══════════════════ TIMER ═══════════════════
      // Meditation
      let medInterval = null, medSeconds = 600, medRunning = false;
      const medDisplay = document.getElementById('med-display');
      const medMinInput = document.getElementById('med-minutes');
      const medStartBtn = document.getElementById('med-start');

      function fmtTime(s) { return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); }

      medMinInput.addEventListener('change', () => { if (!medRunning) { medSeconds = medMinInput.value * 60; medDisplay.textContent = fmtTime(medSeconds); } });

      medStartBtn.addEventListener('click', () => {
        if (medRunning) { clearInterval(medInterval); medRunning = false; medStartBtn.textContent = 'Start'; return; }
        medRunning = true; medStartBtn.textContent = 'Pause';
        medInterval = setInterval(() => {
          medSeconds--;
          medDisplay.textContent = fmtTime(medSeconds);
          if (medSeconds <= 0) { clearInterval(medInterval); medRunning = false; medStartBtn.textContent = 'Start'; alert('Meditation complete!'); }
        }, 1000);
      });

      document.getElementById('med-reset').addEventListener('click', () => {
        clearInterval(medInterval); medRunning = false; medStartBtn.textContent = 'Start';
        medSeconds = medMinInput.value * 60; medDisplay.textContent = fmtTime(medSeconds);
      });

      // Pomodoro
      let pomInterval = null, pomSeconds = 1500, pomRunning = false, pomWork = true;
      const pomDisplay = document.getElementById('pom-display');
      const pomPhase = document.getElementById('pom-phase');
      const pomStartBtn = document.getElementById('pom-start');

      pomStartBtn.addEventListener('click', () => {
        if (pomRunning) { clearInterval(pomInterval); pomRunning = false; pomStartBtn.textContent = 'Start'; return; }
        pomRunning = true; pomStartBtn.textContent = 'Pause';
        pomInterval = setInterval(() => {
          pomSeconds--;
          pomDisplay.textContent = fmtTime(pomSeconds);
          if (pomSeconds <= 0) {
            clearInterval(pomInterval); pomRunning = false; pomStartBtn.textContent = 'Start';
            pomWork = !pomWork;
            pomSeconds = pomWork ? 1500 : 300;
            pomPhase.textContent = pomWork ? 'WORK' : 'BREAK';
            pomDisplay.textContent = fmtTime(pomSeconds);
            alert(pomWork ? 'Break over — back to work!' : 'Work session done — take a break!');
          }
        }, 1000);
      });

      document.getElementById('pom-reset').addEventListener('click', () => {
        clearInterval(pomInterval); pomRunning = false; pomStartBtn.textContent = 'Start';
        pomWork = true; pomSeconds = 1500; pomDisplay.textContent = '25:00'; pomPhase.textContent = 'WORK';
      });

      // Stopwatch
      let swInterval = null, swMs = 0, swRunning = false, swLaps = [];
      const swDisplay = document.getElementById('sw-display');
      const swStartBtn = document.getElementById('sw-start');

      function fmtSw(ms) {
        const min = String(Math.floor(ms / 60000)).padStart(2, '0');
        const sec = String(Math.floor((ms % 60000) / 1000)).padStart(2, '0');
        const cs = String(Math.floor((ms % 1000) / 10)).padStart(2, '0');
        return `${min}:${sec}.${cs}`;
      }

      swStartBtn.addEventListener('click', () => {
        if (swRunning) { clearInterval(swInterval); swRunning = false; swStartBtn.textContent = 'Start'; return; }
        swRunning = true; swStartBtn.textContent = 'Pause';
        const start = Date.now() - swMs;
        swInterval = setInterval(() => { swMs = Date.now() - start; swDisplay.textContent = fmtSw(swMs); }, 10);
      });

      document.getElementById('sw-lap').addEventListener('click', () => {
        if (!swRunning) return;
        swLaps.push(fmtSw(swMs));
        document.getElementById('sw-laps').innerHTML = swLaps.map((l, i) => `<div>Lap ${i + 1}: ${l}</div>`).reverse().join('');
      });

      document.getElementById('sw-reset').addEventListener('click', () => {
        clearInterval(swInterval); swRunning = false; swStartBtn.textContent = 'Start';
        swMs = 0; swDisplay.textContent = '00:00.00'; swLaps = [];
        document.getElementById('sw-laps').innerHTML = '';
      });

      // ═══════════════════ HABIT VIEW TOGGLE ═══════════════════
      document.querySelectorAll('.habit-view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.habit-view-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById('habit-view-today').style.display = btn.dataset.hview === 'today' ? '' : 'none';
          document.getElementById('habit-view-stats').style.display = btn.dataset.hview === 'stats' ? '' : 'none';
          if (btn.dataset.hview === 'stats') renderHabitStats();
        });
      });

      // ═══════════════════ HABITS ═══════════════════
      let allHabits = [], todayLogs = [], allRecentLogs = [];

      function clientToday() { return new Date().toISOString().slice(0, 10); }

      async function loadHabits() {
        try {
          const today = clientToday();
          const [habitsRes, venturesRes] = await Promise.all([
            fetch('/api/habits?today=' + today),
            allVentures.length ? Promise.resolve(null) : fetch('/api/intention?today=' + today),
          ]);
          const data = await habitsRes.json();
          allHabits = (data.habits || []).filter(h => h.status === 'active');
          todayLogs = data.todayLogs || [];
          allRecentLogs = data.recentLogs || [];
          if (venturesRes) {
            const vd = await venturesRes.json();
            allVentures = vd.ventures || [];
          }
          renderHabits();
        } catch { document.getElementById('habits-list').innerHTML = '<div class="empty"><p>Failed to load.</p></div>'; }
      }

      function isDayScheduled(h) {
        if (!h.scheduleDays) return true;
        const days = h.scheduleDays.split(',').map(d => d.trim().toLowerCase()).filter(Boolean);
        if (!days.length) return true;
        const names = ['sun','mon','tue','wed','thu','fri','sat'];
        return days.includes(names[new Date().getDay()]);
      }

      function renderHabits() {
        // Stat bar
        const scheduled = allHabits.filter(h => h.frequency === 'daily' && isDayScheduled(h));
        const doneCount = scheduled.filter(h => todayLogs.some(l => l.habitId === h.id)).length;
        document.getElementById('habit-stat-bar').innerHTML =
          `<div class="habit-stat-pill">Today: <strong>${doneCount}/${scheduled.length}</strong></div>` +
          `<div class="habit-stat-pill">Streak avg: <strong>${scheduled.length ? Math.round(scheduled.reduce((s,h)=>s+h.currentStreak,0)/Math.max(scheduled.length,1)) : 0}</strong></div>`;

        const el = document.getElementById('habits-list');
        if (allHabits.length === 0) { el.innerHTML = '<div class="empty"><p>No habits yet. Add one above!</p></div>'; return; }
        const groups = {};
        allHabits.forEach(h => { const g = h.stackGroup || 'General'; if (!groups[g]) groups[g] = []; groups[g].push(h); });
        let html = '';
        for (const [group, habits] of Object.entries(groups)) {
          html += `<div class="habit-group-label">${esc(group)}</div>`;
          habits.forEach(h => {
            const done = todayLogs.some(l => l.habitId === h.id);
            const scheduled = isDayScheduled(h);
            const opacity = !scheduled ? 'opacity:0.45;' : '';
            html += `<div class="habit-item" style="${opacity}" onclick="toggleHabit('${h.id}', ${done})">
              <div class="habit-check ${done ? 'done' : ''}"></div>
              <div class="habit-name">${esc(h.name)}</div>
              <div style="text-align:right;flex-shrink:0;">
                ${h.currentStreak > 0 ? `<div class="habit-streak">${h.currentStreak} 🔥</div>` : ''}
                <div class="habit-freq">${h.frequency}</div>
              </div>
              <button class="habit-edit-btn" onclick="event.stopPropagation();editHabit('${h.id}')">✎</button>
            </div>`;
          });
        }
        el.innerHTML = html;
      }

      function renderHabitStats() {
        const el = document.getElementById('habits-stats-list');
        if (allHabits.length === 0) { el.innerHTML = '<div class="empty"><p>No habits yet.</p></div>'; return; }
        const logsByHabit = {};
        allRecentLogs.forEach(l => { if (!logsByHabit[l.habitId]) logsByHabit[l.habitId] = new Set(); logsByHabit[l.habitId].add(l.date); });

        // Build 90-day date range
        const days = [];
        const today = clientToday();
        for (let i = 89; i >= 0; i--) {
          const d = new Date(today + 'T12:00:00Z');
          d.setUTCDate(d.getUTCDate() - i);
          days.push(d.toISOString().slice(0, 10));
        }

        let html = '';
        allHabits.forEach(h => {
          const logs = logsByHabit[h.id] || new Set();
          const heatmap = days.map(d => `<div class="heatmap-cell ${logs.has(d) ? 'done' : 'empty'}" title="${d}"></div>`).join('');
          html += `<div class="habit-stats-row">
            <div style="flex:1;">
              <div class="habit-stats-name">${esc(h.name)}</div>
              <div class="habit-stats-meta">
                <span><strong>${h.currentStreak}</strong> streak</span>
                <span>best <strong>${h.longestStreak}</strong></span>
                <span>total <strong>${h.totalCompletions}</strong></span>
                <span style="font-size:11px;color:var(--color-warm-400);">${h.frequency}</span>
              </div>
              <div class="heatmap-row">${heatmap}</div>
            </div>
            <button class="habit-edit-btn" onclick="editHabit('${h.id}')">✎</button>
          </div>`;
        });
        el.innerHTML = html || '<div class="empty"><p>No habits yet.</p></div>';
      }

      // Habit modal
      const habitModal = document.getElementById('habit-modal');
      const habitModalForm = document.getElementById('habit-modal-form');

      document.getElementById('habit-add-btn').addEventListener('click', () => {
        habitModalForm.reset();
        document.getElementById('habit-modal-title').textContent = 'Add Habit';
        populateVentureDropdown('habit-venture-select');
        habitModal.classList.add('open');
      });
      document.getElementById('habit-modal-close').addEventListener('click', () => habitModal.classList.remove('open'));
      habitModal.addEventListener('click', e => { if (e.target === habitModal) habitModal.classList.remove('open'); });

      window.editHabit = function(id) {
        const h = allHabits.find(x => x.id === id);
        if (!h) return;
        habitModalForm.reset();
        habitModalForm.id.value = h.id;
        habitModalForm.name.value = h.name;
        habitModalForm.frequency.value = h.frequency;
        habitModalForm.stackGroup.value = h.stackGroup || '';
        habitModalForm.valueLabel.value = h.valueLabel || '';
        habitModalForm.scheduleDays.value = h.scheduleDays || '';
        document.getElementById('habit-modal-title').textContent = 'Edit Habit';
        populateVentureDropdown('habit-venture-select', h.ventureId);
        habitModal.classList.add('open');
      };

      habitModalForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(habitModalForm);
        const body = Object.fromEntries(fd);
        body.action = 'save';
        body.valueType = body.valueLabel ? 'numeric' : '';
        if (!body.id) delete body.id;
        try {
          const res = await fetch('/api/habits', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { habitModal.classList.remove('open'); loadHabits(); }
          else showStatus('habits-status', 'Failed to save.', 'error');
        } catch { showStatus('habits-status', 'Network error.', 'error'); }
      });

      window.toggleHabit = async function(id, currentlyDone) {
        const action = currentlyDone ? 'uncomplete' : 'complete';
        const today = clientToday();
        try {
          await fetch('/api/habits', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action, id, today }) });
          loadHabits();
        } catch {}
      };

      // ═══════════════════ TODOS ═══════════════════
      let allTodos = [];
      let todoFilter = 'active';
      let allVentures = [];

      async function loadTodos() {
        try {
          const [todosRes, venturesRes] = await Promise.all([
            fetch('/api/todos'),
            allVentures.length ? Promise.resolve(null) : fetch('/api/intention?today=' + clientToday()),
          ]);
          const data = await todosRes.json();
          allTodos = data.todos || [];
          if (venturesRes) {
            const vd = await venturesRes.json();
            allVentures = vd.ventures || [];
          }
          renderTodos();
        } catch { showStatus('todos-status', 'Failed to load todos.', 'error'); }
      }

      function renderTodos() {
        let list = allTodos;
        if (todoFilter === 'active') list = allTodos.filter(t => !t.completed);
        else if (todoFilter === 'done') list = allTodos.filter(t => t.completed);

        const el = document.getElementById('todos-list');
        if (list.length === 0) { el.innerHTML = '<div class="empty"><p>' + (todoFilter === 'done' ? 'No completed tasks.' : 'Nothing here!') + '</p></div>'; return; }

        el.innerHTML = list.map(t => {
          const today = clientToday();
          const overdue = t.dueDate && t.dueDate < today && !t.completed;
          const venture = allVentures.find(v => v.id === t.ventureId);
          const pLabel = ['', 'P1', 'P2', 'P3'][t.priority] || '';
          return `<div class="todo-item">
            <div class="todo-check ${t.completed ? 'done' : ''}" onclick="toggleTodo('${t.id}', ${!!t.completed})"></div>
            <div class="todo-text-wrap">
              <div class="todo-text ${t.completed ? 'done' : ''}">${esc(t.text)}</div>
              <div class="todo-meta">
                ${pLabel ? `<span class="priority-badge priority-${t.priority}">${pLabel}</span>` : ''}
                ${t.dueDate ? `<span class="due-date-label ${overdue ? 'overdue' : ''}">${overdue ? '⚠ ' : ''}${t.dueDate}</span>` : ''}
                ${venture ? `<span class="venture-chip" style="background:${venture.color}22;color:${venture.color};">${esc(venture.icon || '')} ${esc(venture.name)}</span>` : ''}
              </div>
            </div>
            <div class="todo-actions">
              <button class="btn btn-ghost btn-sm" onclick="editTodo('${t.id}')">✎</button>
              <button class="btn btn-danger btn-sm" onclick="deleteTodo('${t.id}')">✕</button>
            </div>
          </div>`;
        }).join('');
      }

      document.querySelectorAll('.todo-filter-bar .filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.todo-filter-bar .filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          todoFilter = btn.dataset.filter;
          renderTodos();
        });
      });

      // Todo modal
      const todoModal = document.getElementById('todo-modal');
      const todoForm = document.getElementById('todo-form');

      document.getElementById('todo-add-btn').addEventListener('click', () => {
        todoForm.reset();
        document.getElementById('todo-modal-title').textContent = 'Add To-Do';
        populateVentureDropdown('todo-venture-select');
        todoModal.classList.add('open');
      });
      document.getElementById('todo-modal-close').addEventListener('click', () => todoModal.classList.remove('open'));
      todoModal.addEventListener('click', e => { if (e.target === todoModal) todoModal.classList.remove('open'); });

      window.editTodo = function(id) {
        const t = allTodos.find(x => x.id === id);
        if (!t) return;
        todoForm.reset();
        todoForm.id.value = t.id;
        todoForm.text.value = t.text;
        todoForm.priority.value = t.priority;
        todoForm.dueDate.value = t.dueDate || '';
        document.getElementById('todo-modal-title').textContent = 'Edit To-Do';
        populateVentureDropdown('todo-venture-select', t.ventureId);
        todoModal.classList.add('open');
      };

      todoForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(todoForm);
        const body = Object.fromEntries(fd);
        if (!body.id) delete body.id;
        try {
          const res = await fetch('/api/todos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { todoModal.classList.remove('open'); loadTodos(); }
          else showStatus('todos-status', 'Failed to save.', 'error');
        } catch { showStatus('todos-status', 'Network error.', 'error'); }
      });

      window.toggleTodo = async function(id, done) {
        try {
          const t = allTodos.find(x => x.id === id);
          if (!t) return;
          await fetch('/api/todos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, text: t.text, completed: !done }) });
          loadTodos();
        } catch {}
      };

      window.deleteTodo = async function(id) {
        if (!confirm('Delete this task?')) return;
        await fetch('/api/todos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        loadTodos();
      };

      // ═══════════════════ INTENTIONS ═══════════════════
      let allGoals = [], allCheckins = [], todayCheckins = [], weekCheckins = [];
      let activeVentureFilter = null;
      let intView = 'horizon';

      async function loadIntentions() {
        try {
          const today = clientToday();
          const res = await fetch('/api/intention?today=' + today);
          const data = await res.json();
          allVentures = data.ventures || [];
          allGoals = data.goals || [];
          allCheckins = data.recentCheckins || [];
          todayCheckins = data.todayCheckins || [];
          weekCheckins = data.weekCheckins || [];
          renderVentureRail();
          renderGoals();
        } catch { console.error('Failed to load intentions'); }
      }

      function renderVentureRail() {
        const active = allVentures.filter(v => v.status === 'active');
        let html = `<div class="venture-item ${!activeVentureFilter ? 'active' : ''}" onclick="setVentureFilter(null)">
          <div class="venture-dot" style="background:var(--color-warm-300);"></div>
          <div class="venture-name">All</div>
        </div>`;
        active.forEach(v => {
          html += `<div class="venture-item ${activeVentureFilter === v.id ? 'active' : ''}" onclick="setVentureFilter('${v.id}')">
            <div class="venture-dot" style="background:${v.color};"></div>
            <div class="venture-name">${esc(v.icon ? v.icon + ' ' : '')}${esc(v.name)}</div>
            <button class="venture-edit" onclick="event.stopPropagation();editVenture('${v.id}')">✎</button>
          </div>`;
        });
        document.getElementById('venture-list').innerHTML = html;
      }

      window.setVentureFilter = function(id) {
        activeVentureFilter = id;
        renderVentureRail();
        renderGoals();
      };

      function goalsForRender() {
        if (!activeVentureFilter) return allGoals;
        return allGoals.filter(g => {
          const ids = (g.ventureIds || '').split(',').map(x => x.trim());
          return ids.includes(activeVentureFilter);
        });
      }

      function goalVentureChips(g) {
        const ids = (g.ventureIds || '').split(',').map(x => x.trim()).filter(Boolean);
        return ids.map(vid => {
          const v = allVentures.find(x => x.id === vid);
          if (!v) return '';
          return `<span class="venture-chip" style="background:${v.color}22;color:${v.color};font-size:11px;padding:1px 6px;border-radius:3px;">${esc(v.icon || '')} ${esc(v.name)}</span>`;
        }).join('');
      }

      function renderGoalCard(g) {
        const checkedToday = todayCheckins.some(c => c.goalId === g.id);
        const pBadge = g.priority > 0 ? `<span class="p-badge p-badge-${g.priority}">P${g.priority}</span>` : '';
        const sizeBadge = g.size ? `<span class="size-badge">${g.size}</span>` : '';
        const statusBadge = `<span class="status-badge status-${g.status}">${g.status}</span>`;
        const why = g.why ? `<div class="goal-why">"${esc(g.why)}"</div>` : '';
        const checkinBtn = `<button class="checkin-btn ${checkedToday ? 'checked' : ''}" onclick="event.stopPropagation();toggleCheckin('${g.id}', ${checkedToday})">${checkedToday ? '✓ Done today' : '+ Mark today'}</button>`;
        return `<div class="goal-card" style="border-left-color:${goalVentureColor(g)};" onclick="expandGoal('${g.id}', this)">
          <div class="goal-card-header">
            <div class="goal-title">${esc(g.title)}</div>
            <div class="goal-badges">${pBadge}${sizeBadge}${statusBadge}${goalVentureChips(g)}</div>
          </div>
          <div class="goal-detail" id="goal-detail-${g.id}">
            ${why}
            ${checkinBtn}
            <div class="goal-actions">
              <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();editGoal('${g.id}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteGoal('${g.id}')">Delete</button>
            </div>
          </div>
        </div>`;
      }

      function goalVentureColor(g) {
        const ids = (g.ventureIds || '').split(',').map(x => x.trim()).filter(Boolean);
        const v = allVentures.find(x => x.id === ids[0]);
        return v ? v.color : 'var(--color-warm-200)';
      }

      window.expandGoal = function(id, card) {
        const detail = document.getElementById('goal-detail-' + id);
        if (!detail) return;
        const isOpen = detail.classList.contains('show');
        detail.classList.toggle('show', !isOpen);
        card.classList.toggle('expanded', !isOpen);
      };

      function renderGoals() {
        const goals = goalsForRender();
        const horizons = ['daily', 'weekly', 'quarterly', 'yearly'];
        if (intView === 'horizon') {
          horizons.forEach(h => {
            const filtered = goals.filter(g => g.horizon === h);
            const el = document.getElementById('goals-' + h);
            el.innerHTML = filtered.length ? filtered.map(renderGoalCard).join('') :
              '<div style="font-size:13px;color:var(--color-warm-400);padding:8px 0;">No goals yet.</div>';
          });
        } else {
          const lanes = ['backlog','todo','working','waiting','done'];
          lanes.forEach(s => {
            const filtered = goals.filter(g => g.status === s);
            const el = document.getElementById('kb-' + s);
            el.innerHTML = filtered.length ? filtered.map(g =>
              `<div class="kanban-card" onclick="editGoal('${g.id}')">
                <div style="font-weight:600;font-size:13px;margin-bottom:4px;">${esc(g.title)}</div>
                <div style="display:flex;gap:4px;flex-wrap:wrap;">${goalVentureChips(g)}${g.size ? `<span class="size-badge">${g.size}</span>` : ''}</div>
              </div>`
            ).join('') : '<div style="font-size:12px;color:var(--color-warm-400);padding:4px;">—</div>';
          });
        }
      }

      document.querySelectorAll('.int-view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.int-view-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          intView = btn.dataset.view;
          document.getElementById('int-view-horizon').style.display = intView === 'horizon' ? '' : 'none';
          document.getElementById('int-view-kanban').style.display = intView === 'kanban' ? '' : 'none';
          renderGoals();
        });
      });

      // Venture modal
      const ventureModal = document.getElementById('venture-modal');
      const ventureForm = document.getElementById('venture-form');

      document.getElementById('venture-add-btn').addEventListener('click', () => {
        ventureForm.reset();
        document.getElementById('venture-modal-title').textContent = 'Add Venture';
        ventureModal.classList.add('open');
      });
      document.getElementById('venture-modal-close').addEventListener('click', () => ventureModal.classList.remove('open'));
      ventureModal.addEventListener('click', e => { if (e.target === ventureModal) ventureModal.classList.remove('open'); });

      window.editVenture = function(id) {
        const v = allVentures.find(x => x.id === id);
        if (!v) return;
        ventureForm.reset();
        ventureForm.id.value = v.id;
        ventureForm.name.value = v.name;
        ventureForm.color.value = v.color;
        ventureForm.icon.value = v.icon || '';
        ventureForm.tagline.value = v.tagline || '';
        document.getElementById('venture-modal-title').textContent = 'Edit Venture';
        ventureModal.classList.add('open');
      };

      ventureForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const body = Object.fromEntries(new FormData(ventureForm));
        if (!body.id) delete body.id;
        body.action = 'save-venture';
        try {
          const res = await fetch('/api/intention', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { ventureModal.classList.remove('open'); loadIntentions(); }
        } catch {}
      });

      // Goal modal
      const goalModal = document.getElementById('goal-modal');
      const goalForm = document.getElementById('goal-form');

      function populateGoalVentureCheckboxes(selectedIds) {
        const ids = Array.isArray(selectedIds) ? selectedIds : (selectedIds || '').split(',').filter(Boolean);
        const el = document.getElementById('goal-venture-checkboxes');
        el.innerHTML = allVentures.filter(v => v.status === 'active').map(v =>
          `<label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
            <input type="checkbox" name="ventureIds" value="${v.id}" ${ids.includes(v.id) ? 'checked' : ''} />
            <span class="venture-dot" style="background:${v.color};"></span>${esc(v.name)}
          </label>`
        ).join('');
      }

      document.getElementById('goal-add-btn').addEventListener('click', () => {
        goalForm.reset();
        document.getElementById('goal-modal-title').textContent = 'Add Goal';
        populateGoalVentureCheckboxes([]);
        goalModal.classList.add('open');
      });
      document.getElementById('goal-modal-close').addEventListener('click', () => goalModal.classList.remove('open'));
      goalModal.addEventListener('click', e => { if (e.target === goalModal) goalModal.classList.remove('open'); });

      window.editGoal = function(id) {
        const g = allGoals.find(x => x.id === id);
        if (!g) return;
        goalForm.reset();
        goalForm.id.value = g.id;
        goalForm.title.value = g.title;
        goalForm.horizon.value = g.horizon;
        goalForm.priority.value = g.priority;
        goalForm.size.value = g.size || '';
        goalForm.status.value = g.status;
        goalForm.why.value = g.why || '';
        goalForm.targetDate.value = g.targetDate || '';
        document.getElementById('goal-modal-title').textContent = 'Edit Goal';
        populateGoalVentureCheckboxes(g.ventureIds || '');
        goalModal.classList.add('open');
      };

      window.deleteGoal = async function(id) {
        if (!confirm('Delete this goal and all its check-ins?')) return;
        await fetch('/api/intention', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete-goal', id }) });
        loadIntentions();
      };

      goalForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(goalForm);
        const body = { action: 'save-goal' };
        const checked = [...goalForm.querySelectorAll('[name="ventureIds"]:checked')].map(cb => cb.value);
        fd.forEach((v, k) => { if (k !== 'ventureIds') body[k] = v; });
        body.ventureIds = checked.join(',');
        if (!body.id) delete body.id;
        try {
          const res = await fetch('/api/intention', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { goalModal.classList.remove('open'); loadIntentions(); }
        } catch {}
      });

      window.toggleCheckin = async function(goalId, done) {
        const action = done ? 'uncheckin' : 'checkin';
        const today = clientToday();
        try {
          await fetch('/api/intention', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action, goalId, date: today }) });
          loadIntentions();
        } catch {}
      };

      // ═══════════════════ OFFICE WORK ═══════════════════
      let owCategories = [], owSessions = [], owTodayTotals = [], owWeekTotals = [], owMonthTotals = [];
      let owView = 'analytics', owAnalyticsRange = 'week', owSessionRange = '30';
      let owTimerActive = false, owTimerCategoryId = null, owTimerStart = null, owTimerInterval = null;

      async function loadOfficeWork() {
        try {
          const res = await fetch('/api/office-work?today=' + clientToday());
          const data = await res.json();
          owCategories = data.categories || [];
          owSessions = data.sessions || [];
          owTodayTotals = data.todayTotals || [];
          owWeekTotals = data.weekTotals || [];
          owMonthTotals = data.monthTotals || [];
          renderOwView();
        } catch { showStatus('ow-status', 'Failed to load office work.', 'error'); }
      }

      function owFmtSec(s) {
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
        return h > 0 ? `${h}h ${m}m` : `${m}m`;
      }
      function owFmtHMS(s) {
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
      }

      function renderOwView() {
        if (owView === 'analytics') renderOwAnalytics();
        else if (owView === 'categories') renderOwCategories();
        else if (owView === 'sessions') renderOwSessions();
      }

      function renderOwAnalytics() {
        const totals = owAnalyticsRange === 'week' ? owWeekTotals : owMonthTotals;
        const maxSec = Math.max(...totals.map(t => t.total), 1);
        const totalSec = totals.reduce((s, t) => s + t.total, 0);
        let html = '';
        totals.sort((a, b) => b.total - a.total).forEach(t => {
          const cat = owCategories.find(c => c.id === t.categoryId);
          if (!cat) return;
          const pct = (t.total / maxSec) * 100;
          html += `<div class="ow-bar-row">
            <div class="ow-bar-label" title="${esc(cat.name)}">${esc(cat.name)}</div>
            <div class="ow-bar-track"><div class="ow-bar-fill" style="width:${pct}%;background:${cat.color};"></div></div>
            <div class="ow-bar-value">${owFmtSec(t.total)}</div>
          </div>`;
        });
        document.getElementById('ow-analytics-bars').innerHTML = html || '<div class="empty"><p>No sessions yet.</p></div>';
        document.getElementById('ow-analytics-total').textContent = totalSec ? 'Total: ' + owFmtSec(totalSec) : '';
      }

      function renderOwCategories() {
        const totals = owWeekTotals;
        const el = document.getElementById('ow-cat-list');
        if (!owCategories.length) { el.innerHTML = '<div class="empty"><p>No categories yet.</p></div>'; return; }
        el.innerHTML = owCategories.map(c => {
          const t = totals.find(x => x.categoryId === c.id);
          return `<div class="ow-cat-item">
            <div class="ow-cat-dot" style="background:${c.color};"></div>
            <div>
              <div class="ow-cat-name">${esc(c.name)}</div>
              <div class="ow-cat-kind">${c.kind}</div>
            </div>
            <div class="ow-cat-total">${t ? owFmtSec(t.total) : '0m'}</div>
            <button class="btn btn-sage btn-sm" onclick="startOwTimer('${c.id}')">▶ Start</button>
            <button class="btn btn-ghost btn-sm" onclick="editOwCat('${c.id}')">✎</button>
            <button class="btn btn-danger btn-sm" onclick="deleteOwCat('${c.id}')">✕</button>
          </div>`;
        }).join('');
      }

      function renderOwSessions() {
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - parseInt(owSessionRange));
        const cutStr = cutoff.toISOString().slice(0, 10);
        const filtered = owSessions.filter(s => s.date >= cutStr);
        const el = document.getElementById('ow-sessions-list');
        if (!filtered.length) { el.innerHTML = '<div class="empty"><p>No sessions yet.</p></div>'; return; }
        el.innerHTML = '<div>' + filtered.map(s => {
          const cat = owCategories.find(c => c.id === s.categoryId);
          return `<div class="ow-session-item">
            <div class="ow-session-date">${s.date}</div>
            <div class="ow-session-cat" style="color:${cat?.color || 'inherit'}">${esc(cat?.name || '?')}</div>
            <div style="flex:1;font-size:12px;color:var(--color-warm-500);">${esc(s.notes || '')}</div>
            <div class="ow-session-dur">${owFmtSec(s.durationSec)}</div>
            <button class="btn btn-danger btn-sm" onclick="deleteOwSession('${s.id}')">✕</button>
          </div>`;
        }).join('') + '</div>';
      }

      // OW view toggle
      document.querySelectorAll('.ow-view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ow-view-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          owView = btn.dataset.view;
          document.getElementById('ow-view-analytics').style.display = owView === 'analytics' ? '' : 'none';
          document.getElementById('ow-view-categories').style.display = owView === 'categories' ? '' : 'none';
          document.getElementById('ow-view-sessions').style.display = owView === 'sessions' ? '' : 'none';
          renderOwView();
        });
      });

      document.querySelectorAll('.ow-range-btn[data-range]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ow-range-btn[data-range]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          owAnalyticsRange = btn.dataset.range;
          renderOwAnalytics();
        });
      });

      document.querySelectorAll('.ow-range-btn[data-srange]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ow-range-btn[data-srange]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          owSessionRange = btn.dataset.srange;
          renderOwSessions();
        });
      });

      // Timer
      window.startOwTimer = function(categoryId) {
        if (owTimerActive) stopOwTimer(false);
        owTimerActive = true;
        owTimerCategoryId = categoryId;
        owTimerStart = Date.now();
        localStorage.setItem('owTimer', JSON.stringify({ categoryId, start: owTimerStart }));
        const cat = owCategories.find(c => c.id === categoryId);
        const banner = document.getElementById('ow-timer-banner');
        document.getElementById('ow-banner-cat').textContent = cat?.name || '';
        banner.style.display = 'flex';
        owTimerInterval = setInterval(updateOwTimerDisplay, 1000);
        updateOwTimerDisplay();
      };

      function updateOwTimerDisplay() {
        if (!owTimerStart) return;
        const elapsed = Math.floor((Date.now() - owTimerStart) / 1000);
        document.getElementById('ow-banner-time').textContent = owFmtHMS(elapsed);
      }

      async function stopOwTimer(save = true) {
        clearInterval(owTimerInterval);
        owTimerInterval = null;
        if (save && owTimerCategoryId && owTimerStart) {
          const endedAt = new Date().toISOString();
          const startedAt = new Date(owTimerStart).toISOString();
          const durationSec = Math.floor((Date.now() - owTimerStart) / 1000);
          if (durationSec > 10) {
            await fetch('/api/office-work', { method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'log-session', categoryId: owTimerCategoryId, startedAt, endedAt, durationSec }) });
            loadOfficeWork();
          }
        }
        owTimerActive = false;
        owTimerCategoryId = null;
        owTimerStart = null;
        localStorage.removeItem('owTimer');
        document.getElementById('ow-timer-banner').style.display = 'none';
      }

      document.getElementById('ow-banner-stop').addEventListener('click', () => stopOwTimer(true));

      // Restore timer from localStorage on page load
      (function restoreTimer() {
        const saved = localStorage.getItem('owTimer');
        if (!saved) return;
        try {
          const { categoryId, start } = JSON.parse(saved);
          owTimerActive = true;
          owTimerCategoryId = categoryId;
          owTimerStart = start;
          const banner = document.getElementById('ow-timer-banner');
          banner.style.display = 'flex';
          owTimerInterval = setInterval(updateOwTimerDisplay, 1000);
          // Update category name once categories are loaded
          document.addEventListener('owCategoriesLoaded', () => {
            const cat = owCategories.find(c => c.id === categoryId);
            document.getElementById('ow-banner-cat').textContent = cat?.name || '';
          });
          updateOwTimerDisplay();
        } catch { localStorage.removeItem('owTimer'); }
      })();

      // OW category modal
      const owCatModal = document.getElementById('ow-cat-modal');
      const owCatForm = document.getElementById('ow-cat-form');

      document.getElementById('ow-cat-add-btn').addEventListener('click', () => {
        owCatForm.reset();
        document.getElementById('ow-cat-modal-title').textContent = 'Add Category';
        owCatModal.classList.add('open');
      });
      document.getElementById('ow-cat-modal-close').addEventListener('click', () => owCatModal.classList.remove('open'));
      owCatModal.addEventListener('click', e => { if (e.target === owCatModal) owCatModal.classList.remove('open'); });

      window.editOwCat = function(id) {
        const c = owCategories.find(x => x.id === id);
        if (!c) return;
        owCatForm.reset();
        owCatForm.id.value = c.id;
        owCatForm.name.value = c.name;
        owCatForm.color.value = c.color;
        owCatForm.kind.value = c.kind;
        document.getElementById('ow-cat-modal-title').textContent = 'Edit Category';
        owCatModal.classList.add('open');
      };

      window.deleteOwCat = async function(id) {
        if (!confirm('Archive this category?')) return;
        await fetch('/api/office-work', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete-category', id }) });
        loadOfficeWork();
      };

      owCatForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const body = Object.fromEntries(new FormData(owCatForm));
        if (!body.id) delete body.id;
        body.action = 'save-category';
        try {
          const res = await fetch('/api/office-work', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { owCatModal.classList.remove('open'); loadOfficeWork(); }
        } catch {}
      });

      // OW session manual log
      const owSessionModal = document.getElementById('ow-session-modal');
      const owSessionForm = document.getElementById('ow-session-form');

      document.getElementById('ow-session-add-btn').addEventListener('click', () => {
        owSessionForm.reset();
        owSessionForm.date.value = clientToday();
        document.getElementById('ow-session-cat-select').innerHTML =
          owCategories.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
        owSessionModal.classList.add('open');
      });
      document.getElementById('ow-session-modal-close').addEventListener('click', () => owSessionModal.classList.remove('open'));
      owSessionModal.addEventListener('click', e => { if (e.target === owSessionModal) owSessionModal.classList.remove('open'); });

      owSessionForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(owSessionForm);
        const durationMin = parseInt(fd.get('durationMin')) || 0;
        const durationSec = durationMin * 60;
        const date = fd.get('date');
        const startedAt = date + 'T09:00:00.000Z';
        const endedAt = new Date(new Date(startedAt).getTime() + durationSec * 1000).toISOString();
        const body = { action: 'log-session', categoryId: fd.get('categoryId'), startedAt, endedAt, durationSec, date, notes: fd.get('notes') };
        try {
          const res = await fetch('/api/office-work', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          if (res.ok) { owSessionModal.classList.remove('open'); loadOfficeWork(); }
        } catch {}
      });

      window.deleteOwSession = async function(id) {
        if (!confirm('Delete this session?')) return;
        await fetch('/api/office-work', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete-session', id }) });
        loadOfficeWork();
      };

      // ═══════════════════ VENTURE DROPDOWN HELPER ═══════════════════
      function populateVentureDropdown(selectId, selectedId) {
        const el = document.getElementById(selectId);
        el.innerHTML = '<option value="">— None —</option>' +
          allVentures.filter(v => v.status === 'active').map(v =>
            `<option value="${v.id}" ${v.id === selectedId ? 'selected' : ''}>${esc(v.icon ? v.icon + ' ' : '')}${esc(v.name)}</option>`
          ).join('');
      }

      // ═══════════════════ SERVICE WORKER REGISTRATION ═══════════════════
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }

      // ═══════════════════ HELPERS ═══════════════════
      function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

      // Load initial tab
      loadFinances();
    </script>
  </body>
</html>
